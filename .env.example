# ==============================================================================
# SQL-TRUST Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables to match your local environment.
# NEVER commit the actual .env file or credentials to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000

# Microsoft SQL Server Configuration
# For Windows Authentication, leave SQL_USER and SQL_PASSWORD empty.
# For local instance: localhost\SQLEXPRESS or .\SQLEXPRESS
# When connecting from Docker, use host.docker.internal,1764 (or configured TCP port)
SQL_SERVER=localhost\SQLEXPRESS
SQL_PORT=1764
SQL_DATABASE=SQLTrust_Control
SQL_USER=
SQL_PASSWORD=
SQL_TRUSTED_CONNECTION=yes
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Shared Backup Directories (Windows Host and Docker Container paths)
SQL_BACKUP_DIR=D:\Desktop\HackShift\SQL Trust\data\backups
BACKUP_LOCAL_DIR=D:\Desktop\HackShift\SQL Trust\data\backups

# SeaweedFS / S3-Compatible Object Storage (Object Lock / WORM Enabled)
SEAWEEDFS_ENDPOINT_URL=http://127.0.0.1:8333
SEAWEEDFS_ACCESS_KEY=sqltrust_admin
SEAWEEDFS_SECRET_KEY=sqltrust_secret_key
SEAWEEDFS_BUCKET=sqltrust-backups-locked
SEAWEEDFS_REGION=us-east-1

# Optional Role-Based Credentials
# Backup Writer: sqltrust_backup_writer / sqltrust_writer_secret_key
# Recovery Reader: sqltrust_recovery_reader / sqltrust_reader_secret_key

# Compatibility Aliases (Optional)
# S3_ENDPOINT_URL=http://127.0.0.1:8333
# S3_ACCESS_KEY_ID=sqltrust_admin
# S3_SECRET_ACCESS_KEY=sqltrust_secret_key
# S3_BUCKET_NAME=sqltrust-backups
# S3_REGION_NAME=us-east-1

# Application Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
